[Unit]
Description=TravelGo Flask Web Application (Gunicorn)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/TravelGo
Environment="PATH=/home/ec2-user/TravelGo/venv/bin"
EnvironmentFile=/home/ec2-user/TravelGo/.env
ExecStart=/home/ec2-user/TravelGo/venv/bin/gunicorn -w 3 -b 0.0.0.0:5000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
